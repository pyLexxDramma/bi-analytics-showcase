# Локальный FTP-режим (не коммитить — в .gitignore)
#
# Быстрый старт:
#   python webapp/scripts/setup_local_ftp_env.py
#   cd webapp/api && uvicorn app.main:app --reload --port 8000
#   POST http://127.0.0.1:8000/api/admin/sync  (Header: Authorization: Bearer local-dev-sync)
#
# WEBAPP_DATA_MODE=ftp
# SHOWCASE_WEB_DIR=../data/web
# WEBAPP_ADMIN_TOKEN=local-dev-sync
# WEBAPP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# BI_FTP_HOST=
# BI_FTP_USER=
# BI_FTP_PASSWORD=
# BI_FTP_REMOTE_DIR=/web
# BI_FTP_PORT=21
# BI_FTP_TLS=0
