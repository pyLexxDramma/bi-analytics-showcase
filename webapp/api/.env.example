# Локальный FTP-режим (не коммитить — в .gitignore)
#
# Быстрый старт:
#   python webapp/scripts/setup_local_ftp_env.py
#   cd webapp/api && uvicorn app.main:app --reload --port 8000
#   POST http://127.0.0.1:8000/api/admin/sync  (Header: Authorization: Bearer local-dev-sync)
#   # sync = FTP → web → web_data.db (фон, job_id)
#   POST http://127.0.0.1:8000/api/admin/ingest  # только web → БД (synthetic тоже)
#
# WEBAPP_DATA_MODE=ftp
# SHOWCASE_WEB_DIR=../data/web
# WEB_DB_PATH=../data/web_data.db
# WEBAPP_REPORT_CACHE_DIR=../data/report_cache
# WEBAPP_ADMIN_TOKEN=local-dev-sync
# WEBAPP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# BI_FTP_HOST=
# BI_FTP_USER=
# BI_FTP_PASSWORD=
# BI_FTP_REMOTE_DIR=/web
# BI_FTP_PORT=21
# BI_FTP_TLS=0
# SHOWCASE_OPENCODE_URL=http://127.0.0.1:4096
# SHOWCASE_OPENCODE_WORKSPACE=/workspace
# SHOWCASE_ASSISTANT_DB=../data/db/assistant.db
# SHOWCASE_ASSISTANT_OUTPUT_DIR=../data/assistant_output
# WEBAPP_AUTH_SECRET=replace-with-at-least-32-random-characters
# WEBAPP_AUTH_TOKEN_TTL_SECONDS=28800
# SHOWCASE_VLLM_BASE_URL=http://127.0.0.1:8001/v1
# SHOWCASE_VLLM_API_KEY=
# SHOWCASE_VLLM_MODEL=Qwen3.5-35B-A3B-GPTQ-Int4
# SHOWCASE_AI_ENABLED=0
# BI_BOOTSTRAP_ADMIN_USERNAME=admin
# BI_BOOTSTRAP_ADMIN_PASSWORD=
# XCA Ask AI (подпись ссылок /ask — секрет только на сервере)
# XCA_ASK_BASE_URL=https://<домен-XCA>
# XCA_ASK_SECRET=
